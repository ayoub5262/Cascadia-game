{
  "$schema": "http://json-schema.org/draft-07/schema",
  "@class": "edu.udo.cs.sopra.ntf.GameInitMessage",
  "type": "object",
  "title": "Cascadia Game Init Message",
  "required": [
    "tileStack",
    "scoringCards",
    "players",
    "wildlifeBag"
  ],
  "properties": {
    "tileStack": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "scoringCards": {
      "type": "array",
      "items": {
        "type": "boolean"
      },
      "minItems": 5,
      "maxItems": 5
    },
    "players": {
      "type": "array",
      "items":{
        "$ref": "#/definitions/NetPlayer"
      },
      "minItems" : 2,
      "maxItems" : 4
    },
    "wildlifeBag": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/NetWildlife"
      },
      "minItems": 100,
      "maxItems": 100
    }
  },
  "additionalProperties": false,

  "definitions": {
    "NetPlayer": {
      "type": "object",
      "required": [
        "name",
        "startingTileID"
      ],
      "properties": {
        "name" : {
          "type": "string"
        },
        "startingTileID": {
          "type": "integer"
        }
      },
      "additionalProperties": false

    },
    "NetWildlife": {
      "type": "string",
      "enum": ["BEAR","ELK","FOX","HAWK","SALMON"]
    }

  }
}
