{
  "$schema": "http://json-schema.org/draft-07/schema",
  "@class": "edu.udo.cs.sopra.ntf.WipeWildlifeMessage",
  "type": "object",
  "title": "Wipe Wildlife Message",
  "required": [
    "usedNatureToken",
    "natureTokenAmount",
    "wipedWildlifeIndices",
    "wildlifeBag"
  ],
  "properties": {
    "usedNatureToken": {
      "type": "boolean"
    },
    "natureTokenAmount": {
      "type": "integer"
    },
    "wipedWildlifeIndices": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "wildlifeBag": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/NetWildlife"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "NetWildlife": {
      "type": "string",
      "enum": ["BEAR", "ELK", "FOX", "HAWK", "SALMON"]
    }
  }
}
